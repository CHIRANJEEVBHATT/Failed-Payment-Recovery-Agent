# Razorpay TEST MODE credentials
# Replace these placeholder values with your actual Test Mode credentials
# in the .env file. NEVER commit the real secret to Git.

RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx

# Maximum number of REAL Razorpay Payment Link API calls
# allowed during one application run.
MAX_REAL_API_CALLS=20
